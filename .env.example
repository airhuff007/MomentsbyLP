# .env.example — Moments by LP
#
# Copy this file to .env for local overrides.
# .env is gitignored — NEVER commit real secrets.
#
# These values are NOT used by Hugo directly (Hugo doesn't read .env).
# They are here as documentation of what Netlify environment variables to set.
#
# In Netlify: Site Settings → Environment Variables

# ── Shopify ──────────────────────────────────────────────────────────────────
# The Storefront API token is safe to expose in the browser (it's read-only).
# Still prefer setting it as a build-time env var injected into your JS bundle
# rather than committing directly to hugo.yaml — but for Hugo Buy Button
# integration it's acceptable in the config since it has no write access.
SHOPIFY_STORE_DOMAIN="moments-by-lp.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# NEVER put these in this file or any committed file:
# SHOPIFY_ADMIN_API_KEY
# SHOPIFY_ADMIN_ACCESS_TOKEN
# SHOPIFY_WEBHOOK_SECRET
# SHOPIFY_PRIVATE_APP_SECRET

# ── MailerLite ───────────────────────────────────────────────────────────────
MAILERLITE_ACCOUNT_ID=""
MAILERLITE_FORM_ID=""
